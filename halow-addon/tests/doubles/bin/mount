#!/usr/bin/env bash
# Fake mount: only a bind mount of a disable_ipv6 file onto itself and its bind remounts.
. "$(dirname "$0")/_mntlib.sh"
opts=""; args=()
while [ $# -gt 0 ]; do
    case "$1" in -o) opts="${2:-}"; shift 2 ;; *) args+=("$1"); shift ;; esac
done
path="${args[$((${#args[@]} - 1))]:-}"
case "$opts" in
    bind)
        fm_log "bind $path"
        if [ "${#args[@]}" -ne 2 ] || [ "${args[0]}" != "${args[1]}" ] || ! fm_path_ok "$path"; then fm_log "VIOLATION mount -o $opts ${args[*]}"; exit 32; fi
        fm_crash bind-before
        fm_fail bind && exit 32
        printf '%s|ro\n' "$path" >> "$FM_STACK"; fm_render
        fm_crash bind-after
        exit 0 ;;
    remount,bind,rw|remount,bind,ro)
        mode="${opts##*,}"
        fm_log "remount-$mode $path"
        if [ "${#args[@]}" -ne 1 ] || ! fm_path_ok "$path"; then fm_log "VIOLATION mount -o $opts ${args[*]}"; exit 32; fi
        fm_fail "remount-$mode" && exit 32
        lines=(); idx=-1; i=0
        while IFS= read -r l; do lines+=("$l"); [ "${l%|*}" = "$path" ] && idx=$i; i=$((i + 1)); done < "$FM_STACK"
        [ "$idx" -ge 0 ] || exit 32
        lines[$idx]="$path|$mode"
        if [ "${#lines[@]}" -gt 0 ]; then printf '%s\n' "${lines[@]}" > "$FM_STACK"; else : > "$FM_STACK"; fi
        fm_render
        [ "$mode" = rw ] && fm_crash remount-rw-after
        exit 0 ;;
    *)
        fm_log "VIOLATION mount -o $opts ${args[*]}"; exit 32 ;;
esac
